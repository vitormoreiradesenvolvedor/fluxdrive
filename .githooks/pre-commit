#!/usr/bin/env bash
# Bloqueia commits diretos em master e development.
# Apenas merges vindos de PRs via CI/CD são aceitos nessas branches.

PROTECTED_BRANCHES="^(master|development)$"
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

if [[ "$CURRENT_BRANCH" =~ $PROTECTED_BRANCHES ]]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  COMMIT BLOQUEADO — branch protegida: '$CURRENT_BRANCH'     ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║  Commits diretos em 'master' e 'development' são proibidos. ║"
    echo "║  Crie uma branch filha:                                      ║"
    echo "║    git checkout -b feature/minha-feature                    ║"
    echo "║    git checkout -b fix/meu-bugfix                           ║"
    echo "║    git checkout -b chore/minha-tarefa                       ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

# Executa verificações de qualidade locais (fast feedback)
if command -v python3 &>/dev/null; then
    # Formatação
    if command -v black &>/dev/null; then
        STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
        if [[ -n "$STAGED_PY" ]]; then
            echo "→ Verificando formatação (black)..."
            echo "$STAGED_PY" | xargs black --check --quiet 2>&1
            if [[ $? -ne 0 ]]; then
                echo "✗ Formatação inválida. Execute: black src/ tests/"
                exit 1
            fi
            echo "→ Verificando imports (isort)..."
            echo "$STAGED_PY" | xargs isort --check-only --quiet 2>&1
            if [[ $? -ne 0 ]]; then
                echo "✗ Imports desordenados. Execute: isort src/ tests/"
                exit 1
            fi
        fi
    fi
fi

exit 0
