#!/usr/bin/env bash
# Remove qualquer referência a ferramentas de IA do template de commit.
# Garante histórico limpo sem atribuições automáticas indevidas.

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

if [[ "$COMMIT_SOURCE" == "merge" ]]; then
    exit 0
fi

# Remove linhas que contenham referências a IA / geradores automáticos
sed -i '/Co-Authored-By:/d' "$COMMIT_MSG_FILE"
sed -i '/Generated by/d' "$COMMIT_MSG_FILE"
sed -i '/🤖/d' "$COMMIT_MSG_FILE"

exit 0
